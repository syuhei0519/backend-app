# syntax=docker/dockerfile:1.7
# CIのBuildKitが読む複数段ビルド定義。ソースと固定依存から実行用イメージを作る。
# 入口はci/github/oci.sh、成果物のdigest検査はtools/oci-input/layout.go。
# VCS_REF/VCS_SOURCEをOCIラベルへ結び、build用依存を最終runtimeへそのまま持ち込まない。
FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS build
WORKDIR /src
COPY go.mod go.sum ./
# Optional build-only trust; never copy the bundle or persist its path with ENV.
RUN --mount=type=secret,id=build_ca,target=/run/secrets/build_ca,required=false \
    if [ -e /run/secrets/build_ca ]; then \
      test -s /run/secrets/build_ca || { echo 'Empty build CA bundle' >&2; exit 1; }; \
      export SSL_CERT_FILE=/run/secrets/build_ca; \
    fi; \
    go mod download
COPY . .
ARG VCS_REF=unknown
# trimpathとGo symbolを残す。trimpathでbuild-infoからldflagsが省略されても、Trivyがバイナリ内のstamp済みmain module versionを読めるようにする。
RUN go test ./... && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-X main.buildCommit=${VCS_REF} -X main.version=0.0.0+git.${VCS_REF}" -o /out/order-server ./cmd/order-server
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG VCS_REF=unknown
ARG VCS_SOURCE=unknown
LABEL org.opencontainers.image.revision=$VCS_REF org.opencontainers.image.source=$VCS_SOURCE
COPY --from=build --chown=10001:10001 /out/order-server /order-server
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/order-server"]
