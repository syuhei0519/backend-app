{
  "name": "sast-codeql-high",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {"include": ["refs/heads/main"], "exclude": []}
  },
  "rules": [
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {"tool": "CodeQL", "alerts_threshold": "none", "security_alerts_threshold": "high_or_higher"}
        ]
      }
    }
  ]
}
